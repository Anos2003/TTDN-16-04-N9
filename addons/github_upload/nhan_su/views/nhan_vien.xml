<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_nhan_vien_form" model="ir.ui.view">
        <field name="name">nhan_vien</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
<form>
<sheet>
<div class="oe_title">
<h1>
<field name="name" readonly="1" class="oe_inline"/>
</h1>
</div>
<group>
<group string="Thông tin cá nhân">
<field name="ma_dinh_danh"/>
<field name="ho"/>
<field name="ten"/>
<field name="ngay_sinh"/>
<field name="que_quan"/>
<field name="dia_chi"/>
</group>
<group string="Thông tin liên lạc">
<field name="email"/>
<field name="so_dien_thoai"/>
</group>
</group>
<group>
<group string="Công việc">
<field name="phong_ban_id"/>
<field name="chuc_vu_id"/>
<field name="luong"/>
<field name="ngay_vao_lam"/>
<field name="user_id"/>
<field name="trang_thai"/>
</group>
</group>
</sheet>
</form>
        </field>
    </record>
    <record id="view_nhan_vien_tree" model="ir.ui.view">
        <field name="name">nhan_vien</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
<tree>
<field name="ma_dinh_danh"/>
<field name="name"/>
<field name="phong_ban_id"/>
<field name="chuc_vu_id"/>
<field name="email"/>
<field name="trang_thai"/>
</tree>
        </field>
    </record>
    <record model="ir.ui.view" id="nhan_vien_search">
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
<search>
<field name="ma_dinh_danh"/>
<field name="name"/>
<field name="phong_ban_id"/>
<field name="chuc_vu_id"/>
<field name="email"/>
<filter name="active" string="Đang làm việc" domain="[('trang_thai', '=', 'active')]"/>
<filter name="inactive" string="Nghỉ việc" domain="[('trang_thai', '=', 'inactive')]"/>
</search>
        </field>
    </record>
    <record id="action_nhan_vien" model="ir.actions.act_window">
        <field name="name">Nhân viên</field>
        <field name="res_model">nhan_vien</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="nhan_vien_search"/>
    </record>
    <!-- Phong Ban -->
    <record id="view_phong_ban_form" model="ir.ui.view">
        <field name="name">phong_ban</field>
        <field name="model">phong_ban</field>
        <field name="arch" type="xml">
<form>
<sheet>
<div class="oe_title">
<h1>
<field name="name"/>
</h1>
</div>
<group>
<field name="mo_ta"/>
</group>
</sheet>
</form>
        </field>
    </record>
    <record id="view_phong_ban_tree" model="ir.ui.view">
        <field name="name">phong_ban</field>
        <field name="model">phong_ban</field>
        <field name="arch" type="xml">
<tree>
<field name="name"/>
<field name="mo_ta"/>
</tree>
        </field>
    </record>
    <record id="action_phong_ban" model="ir.actions.act_window">
        <field name="name">Phòng ban</field>
        <field name="res_model">phong_ban</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!-- Chuc Vu -->
    <record id="view_chuc_vu_form" model="ir.ui.view">
        <field name="name">chuc_vu</field>
        <field name="model">chuc_vu</field>
        <field name="arch" type="xml">
<form>
<sheet>
<div class="oe_title">
<h1>
<field name="name"/>
</h1>
</div>
<group>
<field name="mo_ta"/>
</group>
</sheet>
</form>
        </field>
    </record>
    <record id="view_chuc_vu_tree" model="ir.ui.view">
        <field name="name">chuc_vu</field>
        <field name="model">chuc_vu</field>
        <field name="arch" type="xml">
<tree>
<field name="name"/>
<field name="mo_ta"/>
</tree>
        </field>
    </record>
    <record id="action_chuc_vu" model="ir.actions.act_window">
        <field name="name">Chức vụ</field>
        <field name="res_model">chuc_vu</field>
        <field name="view_mode">tree,form</field>
    </record>
    </data>
</odoo>
